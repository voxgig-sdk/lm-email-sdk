# Entity: email_create_domain

main: kit: entity: email_create_domain: {

  alias: field: {}

  fields: [
    {
      name: "domain"
      req: true
      short: "Domain address"
      type: "`$STRING`"
    }
  ]

  name: "email_create_domain"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/email/v1/domains"
          parts: [
            "email"
            "v1"
            "domains"
          ]
          transform: {
            req: {
              domain: "`reqdata.domain`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
