# Entity: send_message

main: kit: entity: send_message: {

  alias: field: {}

  name: "send_message"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/email/v1/messages"
          segments: [
            {
              lit: "email"
            }
            {
              lit: "v1"
            }
            {
              lit: "messages"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
